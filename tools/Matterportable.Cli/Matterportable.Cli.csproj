<Project Sdk="Microsoft.NET.Sdk">
  <!-- Command-line front end for the package Core library. Run: dotnet run (project tools/Matterportable.Cli) then the command, e.g. "help". -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>matterportable</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Packages/com.thepromptcook.matterportable/Runtime/Core/**/*.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
