<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs the package's Core tests (Tests/Core) outside Unity: `dotnet test tools/Matterportable.Core.Tests`.
       The same test files also run inside Unity's Test Runner. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Packages/com.thepromptcook.matterportable/Runtime/Core/**/*.cs" />
    <Compile Include="../../Packages/com.thepromptcook.matterportable/Tests/Core/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>
</Project>
