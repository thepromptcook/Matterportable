<Project Sdk="Microsoft.NET.Sdk">
  <!-- Builds the engine-agnostic Core sources outside Unity (netstandard2.0 = Unity's API compatibility level). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <AssemblyName>Matterportable.Core</AssemblyName>
    <RootNamespace>Matterportable.Core</RootNamespace>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Packages/com.thepromptcook.matterportable/Runtime/Core/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Net.Http" Version="4.3.4" />
  </ItemGroup>
</Project>
